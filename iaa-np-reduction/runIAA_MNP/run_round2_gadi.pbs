#!/bin/bash
#PBS -P p00
#PBS -q normal
#PBS -l ncpus=48
#PBS -l mem=32GB
#PBS -l walltime=03:00:00
#PBS -l jobfs=10GB
#PBS -l storage=scratch/p00
#PBS -l wd
#PBS -N MNP_R2_5000As
#PBS -M Jonathan.Ting@anu.edu.au
#PBS -m abe

set -euo pipefail

echo "Job started on $(hostname) at $(date)"

# Activate virtual environment on Gadi
REPO_ROOT="/scratch/p00/jt5911/iterative-archetypal-analysis"
VENV="$REPO_ROOT/iteraa/.venv"

if [ -f "$VENV/bin/activate" ]; then
    source "$VENV/bin/activate"
else
    echo "Virtual environment not found at $VENV"
    exit 1
fi

export NCPUS=48
export OMP_NUM_THREADS=48

PYTHON="$VENV/bin/python"
SCRIPT="$REPO_ROOT/iaa-np-reduction/runIAA_MNP/runIAA_MNP_round2_gadi.py"

cd "$REPO_ROOT"
$PYTHON "$SCRIPT"

echo "Job completed at $(date)"
